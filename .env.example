# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Required in production: canonical URLs, hreflang, the
# sitemap and Open Graph images are all built from it.
NEXT_PUBLIC_SITE_URL=https://gomammy.com

# Force-allow indexing outside production (use only on a staging site you
# deliberately want indexed). Everything non-production is noindex by default.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# ─── Analytics ───────────────────────────────────────────────────────────────
# GA4 measurement ID (G-XXXXXXXXXX). The tag is only injected after the reader
# accepts analytics cookies; leave empty to run the site with no analytics.
NEXT_PUBLIC_GA_ID=

# App Store Connect provider token, if your account uses one. App Store links
# already carry the campaign token `ct`; `pt` is optional.
NEXT_PUBLIC_APPLE_PROVIDER_TOKEN=

# ─── CMS (Sanity) ────────────────────────────────────────────────────────────
# Leave empty to run entirely on the seed content in src/content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Read token, only needed for private datasets or draft previews.
SANITY_API_READ_TOKEN=
